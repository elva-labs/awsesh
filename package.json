{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "awsesh-workspace",
  "version": "1.5.1",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/awsesh src/index.ts",
    "dev:watch": "bun --watch --cwd packages/awsesh src/index.ts",
    "start": "bun run --cwd packages/awsesh src/index.ts",
    "build": "bun run --filter awsesh build",
    "dev:desktop": "bun run --cwd packages/desktop dev",
    "build:desktop": "bun run --cwd packages/desktop build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build:sdk": "bun run --filter '@awsesh/core' build",
    "release:prepare": "bun run packages/scripts/prepare-release.ts"
  },
  "devDependencies": {
    "@awsesh/script": "workspace:*"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.2",
    "@aws-sdk/xml-builder": "3.972.43"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elva-labs/awsesh.git"
  },
  "license": "MIT"
}

{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "awsesh",
  "version": "1.4.3",
  "description": "AWS SSO session manager with OpenTUI",
  "type": "module",
  "private": true,
  "bin": {
    "awsesh": "./src/index.ts",
    "sesh": "./src/index.ts"
  },
  "scripts": {
    "dev": "AWSESH_DEV=1 bun run --conditions=browser src/index.ts",
    "dev:watch": "AWSESH_DEV=1 bun --watch --conditions=browser src/index.ts",
    "start": "bun run --conditions=browser src/index.ts",
    "build": "bun run ./script/build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@awsesh/core": "workspace:*",
    "@awsesh/script": "workspace:*",
    "@awsesh/themes": "workspace:*",
    "@clack/prompts": "^1.9.0",
    "@opentui/core": "0.9.2",
    "@opentui/solid": "0.9.2",
    "fuzzysort": "^4.0.2",
    "open": "11.0.4",
    "remeda": "^2.62.1",
    "solid-js": "1.9.19",
    "xdg-basedir": "5.1.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@types/yargs": "17.0.35",
    "@types/bun": "1.4.4",
    "@tsconfig/bun": "1.0.12",
    "typescript": "5.9.3"
  }
}

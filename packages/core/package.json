{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@awsesh/core",
  "version": "1.5.0",
  "description": "AWS SSO session management SDK",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run ./script/build.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sso": "^3.1171.0",
    "@aws-sdk/client-sso-oidc": "^3.1171.0"
  },
  "devDependencies": {
    "@awsesh/script": "workspace:*",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elva-labs/awsesh.git"
  },
  "license": "MIT"
}
